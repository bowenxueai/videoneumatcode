# ============================================================================
# VideoNeuMat one-click — configuration
# ----------------------------------------------------------------------------
# All CODE is in this repo (diffsynth is vendored at ./diffsynth; the small rig /
# null-text assets are in ./assets). Only heavy ASSETS live outside git — the
# Wan-2.1 base weights, the fine-tuned generators, the LRM checkpoints, and the
# enroot container. Get them with release/download_weights.sh, then this file
# points at them by default (or override any var in the environment — ":=" means
# an already-exported value always wins).
# ============================================================================

# ---- Repo + weights layout (auto-derived) ----------------------------------
: "${NEUGEN_REPO:=$(cd "${RELEASE_DIR:-$(dirname "${BASH_SOURCE[0]:-$0}")}/.." 2>/dev/null && pwd)}"
: "${WEIGHTS_DIR:=${NEUGEN_REPO}/weights}"   # where release/download_weights.sh downloads everything

# ---- Stage A: text->video generation (Wan2.1-T2V-14B) ----------------------
# diffsynth is VENDORED (./diffsynth). GEN_ENV is only a Python env with the gen
# deps (init/gen_requirements.txt); on our cluster we reuse an existing one.
: "${GEN_ENV:=/lustre/fsw/portfolios/nvr/users/bowenx/DiffSynth-Studio/env}"
: "${WAN_MODELS:=${WEIGHTS_DIR}}"                                                   # holds Wan-AI/Wan2.1-T2V-14B (gen) and Wan2.1-T2V-1.3B (LRM)
: "${MATERIAL_CKPT:=${WEIGHTS_DIR}/videoneumat/t2v/videoneumat-t2v.safetensors}"      # default generator: T2V full DiT

# ---- Stage B: LRM neural-material extraction (container) --------------------
: "${NEUGEN_CONTAINER:=/lustre/fsw/portfolios/nvr/users/shadadan/cache/neugen.sqsh}"  # SLURM path: enroot squashfs (build from init/Dockerfile)
: "${NEUGEN_ENV:=}"   # LOCAL path only (release/run_local.sh): a python env dir with the NeuGen/LRM deps (init/environment.yml + h5py)
: "${LRM_LATENT:=${WEIGHTS_DIR}/videoneumat/lrm/videoneumat-lrm.pth}"                   # LRM encoder
: "${LRM_MLP:=${WEIGHTS_DIR}/videoneumat/lrm/videoneumat-decoder.pth}"                                # shared MLP decoder

# ---- SLURM ------------------------------------------------------------------
: "${ACCOUNT:=nvr_rtr_neugen}"
: "${PARTITION:=polar3}"

# ---- Generation params (match the released material fine-tune) -------------
: "${NUM_FRAMES:=81}"    # frames == the 81-pose sparse BTF rig the LRM expects
: "${RES:=1024}"
: "${STEPS:=50}"
: "${CFG:=5.0}"
: "${SEED:=0}"
: "${NEG_STYLE:=none}"   # empty negative prompt == what produced the training videos
: "${GEN_MODE:=full}"    # full = full fine-tuned DiT (default) | lora = LoRA on base Wan2.1-T2V-14B (set MATERIAL_CKPT=.../videoneumat-t2v-lora.safetensors)

# ---- I2V (image->video) generator ------------------------------------------
: "${I2V_CKPT:=${WEIGHTS_DIR}/videoneumat/i2v/videoneumat-i2v.safetensors}"   # fine-tuned Wan2.1-I2V-14B DiT
: "${I2V_BASE_ID:=Wan-AI/Wan2.1-I2V-14B-720P}"                                 # base under WAN_MODELS for i2v

export NEUGEN_REPO WEIGHTS_DIR GEN_ENV WAN_MODELS MATERIAL_CKPT GEN_MODE I2V_CKPT I2V_BASE_ID
export NEUGEN_CONTAINER NEUGEN_ENV LRM_LATENT LRM_MLP
export ACCOUNT PARTITION NUM_FRAMES RES STEPS CFG SEED NEG_STYLE
